-	{name: "go/bin/go.exe", goos: "windows"},
-	{name: "go/bin/gofmt", goos: "linux"},
-	{name: "go/bin/gofmt", goos: "darwin"},
-	{name: "go/bin/gofmt", goos: "windows", exclude: true},
-	{name: "go/bin/gofmt.exe", goos: "windows"},
+	{name: "go/bin/mygo", goos: "linux"},
+	{name: "go/bin/mygo", goos: "darwin"},
+	{name: "go/bin/mygo", goos: "windows", exclude: true},
+	{name: "go/bin/mygo.exe", goos: "windows"},
+	{name: "go/bin/mygofmt", goos: "linux"},
+	{name: "go/bin/mygofmt", goos: "darwin"},
+	{name: "go/bin/mygofmt", goos: "windows", exclude: true},
+	{name: "go/bin/mygofmt.exe", goos: "windows"},
 	{name: "go/pkg/tool/*/compile", goos: "linux"},
 	{name: "go/pkg/tool/*/compile", goos: "darwin"},
 	{name: "go/pkg/tool/*/compile", goos: "windows", exclude: true},
@@ -90,14 +90,14 @@ var modRules = []testRule{
 	{name: "golang.org/toolchain@*/src/cmd/dist/dist", exclude: true},
 	{name: "golang.org/toolchain@*/src/cmd/dist/dist.exe", exclude: true},
 
-	{name: "golang.org/toolchain@*/bin/go", goos: "linux"},
-	{name: "golang.org/toolchain@*/bin/go", goos: "darwin"},
-	{name: "golang.org/toolchain@*/bin/go", goos: "windows", exclude: true},
-	{name: "golang.org/toolchain@*/bin/go.exe", goos: "windows"},
-	{name: "golang.org/toolchain@*/bin/gofmt", goos: "linux"},
-	{name: "golang.org/toolchain@*/bin/gofmt", goos: "darwin"},
-	{name: "golang.org/toolchain@*/bin/gofmt", goos: "windows", exclude: true},
-	{name: "golang.org/toolchain@*/bin/gofmt.exe", goos: "windows"},
+	{name: "golang.org/toolchain@*/bin/mygo", goos: "linux"},
+	{name: "golang.org/toolchain@*/bin/mygo", goos: "darwin"},
+	{name: "golang.org/toolchain@*/bin/mygo", goos: "windows", exclude: true},
+	{name: "golang.org/toolchain@*/bin/mygo.exe", goos: "windows"},
+	{name: "golang.org/toolchain@*/bin/mygofmt", goos: "linux"},
+	{name: "golang.org/toolchain@*/bin/mygofmt", goos: "darwin"},
+	{name: "golang.org/toolchain@*/bin/mygofmt", goos: "windows", exclude: true},
+	{name: "golang.org/toolchain@*/bin/mygofmt.exe", goos: "windows"},
 	{name: "golang.org/toolchain@*/pkg/tool/*/compile", goos: "linux"},
 	{name: "golang.org/toolchain@*/pkg/tool/*/compile", goos: "darwin"},
 	{name: "golang.org/toolchain@*/pkg/tool/*/compile", goos: "windows", exclude: true},
diff --git a/src/run.bash b/src/run.bash
index cb474325c4..574495b85e 100755
--- a/src/run.bash
+++ b/src/run.bash
@@ -24,13 +24,13 @@
 
 set -e
 
-if [ ! -f ../bin/go ]; then
-	echo 'run.bash must be run from $GOROOT/src after installing cmd/go' 1>&2
+if [ ! -f ../bin/mygo ]; then
+	echo 'run.bash must be run from $GOROOT/src after installing cmd/go as mygo' 1>&2
 	exit 1
 fi
 
 export GOENV=off
-eval $(../bin/go tool dist env)
+eval $(../bin/mygo tool dist env)
 
 unset CDPATH	# in case user has it set
 
@@ -50,4 +50,4 @@ if ulimit -T &> /dev/null; then
 fi
 
 export GOPATH=/nonexist-gopath
-exec ../bin/go tool dist test -rebuild "$@"
+exec ../bin/mygo tool dist test -rebuild "$@"
