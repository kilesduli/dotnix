+typedef struct embedded_file {
+    const char          *name;
+    const unsigned char *start;
+    const unsigned char *end;
+    int                  fd;
+    char                 path[PROC_FD_PATH_MAX];
+} embedded_file;
+
+static embedded_file embedded_dicts[] = {
+    { "jieba.dict.utf8", _binary_cjieba_dict_jieba_dict_utf8_start,
+      _binary_cjieba_dict_jieba_dict_utf8_end, -1, { 0 } },
+    { "hmm_model.utf8", _binary_cjieba_dict_hmm_model_utf8_start,
+      _binary_cjieba_dict_hmm_model_utf8_end, -1, { 0 } },
+    { "user.dict.utf8", _binary_cjieba_dict_user_dict_utf8_start,
+      _binary_cjieba_dict_user_dict_utf8_end, -1, { 0 } },
+    { "idf.utf8", _binary_cjieba_dict_idf_utf8_start,
+      _binary_cjieba_dict_idf_utf8_end, -1, { 0 } },
+    { "stop_words.utf8", _binary_cjieba_dict_stop_words_utf8_start,
+      _binary_cjieba_dict_stop_words_utf8_end, -1, { 0 } },
+};
+
+static void print_usage (const char *program) {
+    fprintf (stderr, "Usage:\n\
+  %s\n\
+  %s PORT\n",
+             program, program);
+}
+
+static int write_all (int fd, const unsigned char *data, size_t len) {
+    while (len > 0) {
+        ssize_t written = write (fd, data, len);
+        if (written == -1) {
+            if (errno == EINTR) {
+                continue;
+            }
+            return -1;
+        }
+        data += written;
+        len -= written;
+    }
+    return 0;
+}
+
+static int create_memfd (const char *name) {
+#ifdef SYS_memfd_create
+    return (int) syscall (SYS_memfd_create, name, MFD_CLOEXEC);
+#else
+    errno = ENOSYS;
+    return -1;
+#endif
+}
+
+static void close_embedded_dicts (void) {
+    size_t i;
+
+    for (i = 0; i < ARRAY_LEN (embedded_dicts); i++) {
+        if (embedded_dicts[i].fd != -1) {
+            close (embedded_dicts[i].fd);
+            embedded_dicts[i].fd = -1;
+        }
+        embedded_dicts[i].path[0] = '\0';
+    }
+}
+
+static int prepare_embedded_file (embedded_file *file) {
+    int    path_len;
+    size_t data_len = (size_t) (file->end - file->start);
+
+    file->fd = create_memfd (file->name);
+    if (file->fd == -1) {
+        fprintf (stderr, "create embedded dict memfd %s error: %s(errno: %d)\n",
+                 file->name, strerror (errno), errno);
+        return -1;
+    }
+
+    if (write_all (file->fd, file->start, data_len) == -1) {
+        fprintf (stderr, "write embedded dict %s error: %s(errno: %d)\n",
+                 file->name, strerror (errno), errno);
+        close (file->fd);
+        file->fd = -1;
+        return -1;
+    }
+
+    if (lseek (file->fd, 0, SEEK_SET) == -1) {
+        fprintf (stderr, "rewind embedded dict %s error: %s(errno: %d)\n",
+                 file->name, strerror (errno), errno);
+        close (file->fd);
+        file->fd = -1;
+        return -1;
+    }
+
+    path_len = snprintf (file->path, sizeof (file->path), "/proc/self/fd/%d",
+                         file->fd);
+    if (path_len < 0 || (size_t) path_len >= sizeof (file->path)) {
+        fprintf (stderr, "embedded dict path too long: %s\n", file->name);
+        close (file->fd);
+        file->fd = -1;
+        return -1;
+    }
+
+    return 0;
+}
+
+static int prepare_embedded_jieba_args (const char *program,
+                                        const char **jieba_argv) {
+    size_t i;
+
+    atexit (close_embedded_dicts);
+
+    for (i = 0; i < ARRAY_LEN (embedded_dicts); i++) {
+        if (prepare_embedded_file (&embedded_dicts[i]) == -1) {
+            close_embedded_dicts ();
+            return -1;
+        }
+    }
+
+    jieba_argv[0] = program;
+    for (i = 0; i < ARRAY_LEN (embedded_dicts); i++) {
+        jieba_argv[i + 1] = embedded_dicts[i].path;
+    }
+
+    return 0;
+}
 
 void clean_up (int signum) {
     fprintf (stderr, "\n[signum=%d] clean up... ", signum);
     FreeJieba (handle);
-    close (socket_fd);
