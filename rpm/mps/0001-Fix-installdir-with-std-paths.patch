From d16231316051123105f794de4ab9563b1ea88322 Mon Sep 17 00:00:00 2001
From: duli <duli4868@gmail.com>
Date: Wed, 7 May 2025 18:45:51 +0800
Subject: [PATCH] Fix installdir with std paths

---
 Makefile.in | 27 +++++++++++++++------------
 1 file changed, 15 insertions(+), 12 deletions(-)

diff --git a/Makefile.in b/Makefile.in
index a1e875940..eb41d6ef7 100644
--- a/Makefile.in
+++ b/Makefile.in
@@ -22,7 +22,10 @@ MPS_ARCH_NAME=@MPS_ARCH_NAME@
 MPS_BUILD_NAME=@MPS_BUILD_NAME@
 MPS_TARGET_NAME=$(MPS_OS_NAME)$(MPS_ARCH_NAME)$(MPS_BUILD_NAME)
 EXTRA_TARGETS=@EXTRA_TARGETS@
-prefix=$(DESTDIR)@prefix@
+prefix=@prefix@
+bindir=@bindir@
+libdir=@libdir@
+includedir=@includedir@
 TARGET_OPTS=-C code -f $(MPS_TARGET_NAME).gmk EXTRA_TARGETS="$(EXTRA_TARGETS)"
 XCODEBUILD=xcrun xcodebuild -project code/mps.xcodeproj
 
@@ -35,10 +38,10 @@ clean-make-build:
 	$(MAKE) $(TARGET_OPTS) clean
 
 install-make-build: make-install-dirs build-via-make
-	$(INSTALL_DATA) code/mps*.h $(prefix)/include/
-	$(INSTALL_DATA) code/$(MPS_TARGET_NAME)/cool/mps.a $(prefix)/lib/libmps-debug.a
-	$(INSTALL_DATA) code/$(MPS_TARGET_NAME)/hot/mps.a $(prefix)/lib/libmps.a
-	for PROGRAM in $(EXTRA_TARGETS); do $(INSTALL_PROGRAM) code/$(MPS_TARGET_NAME)/hot/$$PROGRAM $(prefix)/bin/$$PROGRAM; done
+	$(INSTALL_DATA) code/mps*.h $(DESTDIR)$(includedir)/
+	$(INSTALL_DATA) code/$(MPS_TARGET_NAME)/cool/mps.a $(DESTDIR)$(libdir)/libmps-debug.a
+	$(INSTALL_DATA) code/$(MPS_TARGET_NAME)/hot/mps.a $(DESTDIR)$(libdir)/libmps.a
+	for PROGRAM in $(EXTRA_TARGETS); do $(INSTALL_PROGRAM) code/$(MPS_TARGET_NAME)/hot/$$PROGRAM $(DESTDIR)$(bindir)/$$PROGRAM; done
 
 build-via-xcode:
 	$(XCODEBUILD) -config Debug
@@ -49,10 +52,10 @@ clean-xcode-build:
 	$(XCODEBUILD) -config Release clean
 
 install-xcode-build: make-install-dirs build-via-xcode
-	$(INSTALL_DATA) code/mps*.h $(prefix)/include/
-	$(INSTALL_DATA) code/xc/Debug/libmps.a $(prefix)/lib/libmps-debug.a
-	$(INSTALL_DATA) code/xc/Release/libmps.a $(prefix)/lib/libmps.a
-	for PROGRAM in $(EXTRA_TARGETS); do $(INSTALL_PROGRAM) code/xc/Release/$$PROGRAM $(prefix)/bin/$$PROGRAM; done
+	$(INSTALL_DATA) code/mps*.h $(DESTDIR)$(includedir)/
+	$(INSTALL_DATA) code/xc/Debug/libmps.a $(DESTDIR)$(libdir)/libmps-debug.a
+	$(INSTALL_DATA) code/xc/Release/libmps.a $(DESTDIR)$(libdir)/libmps.a
+	for PROGRAM in $(EXTRA_TARGETS); do $(INSTALL_PROGRAM) code/xc/Release/$$PROGRAM $(DESTDIR)$(bindir)/$$PROGRAM; done
 
 Makefile: Makefile.in config.status
 	./config.status Makefile
@@ -68,9 +71,9 @@ distclean: clean
 	rm -rf autom4te.cache/ config.log config.status Makefile
 
 make-install-dirs:
-	mkdir -p $(prefix)/bin
-	mkdir -p $(prefix)/lib
-	mkdir -p $(prefix)/include
+	mkdir -p $(DESTDIR)$(bindir)
+	mkdir -p $(DESTDIR)$(libdir)
+	mkdir -p $(DESTDIR)$(includedir)
 
 install: @INSTALL_TARGET@
 
-- 
