# -*- mode: sh -*-
# oh-my-zsh
# ZSH="$HOME/.oh-my-zsh"
# ZSH_CUSTOM="$ZSH/custom"
# Environment variables for nix
. "/home/duli/.nix-profile/etc/profile.d/hm-session-vars.sh"

# Only source this once
if [[ -z "$__HM_ZSH_SESS_VARS_SOURCED" ]]; then
  export __HM_ZSH_SESS_VARS_SOURCED=1
fi

ZSH_CACHE_DIR="$HOME/.cache/oh-my-zsh"

# go
export GOPATH="$HOME/.go"

# emacs
export LSP_USE_PLISTS="true"

# pyenv
export PYENV_ROOT="$HOME/.pyenv"

# dotnet
export DOTNET_ROOT="$HOME/.dotnet"

# PATH
prepend_paths=(
  "$MYGO_HOME/bin"
  "$HOME/clone/jai/bin"
  "$HOME/.cargo/bin"
  "$DOTNET_ROOT"
  "$DOTNET_ROOT/tools"
)

append_paths=(
  "/opt/clojure/bin"
  "$GOPATH/bin"
  "$HOME/.emacs.d/bin"
)

for p in "${prepend_paths[@]}"; do
  PATH="${p}:${PATH}"
done

for p in "${append_paths[@]}"; do
  PATH="${PATH}:${p}"
done

export PATH
