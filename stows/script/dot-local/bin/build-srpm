#!/usr/bin/env sh

while [ "$#" -gt 0 ]; do
    case "$1" in
        --spec) spec="$2"; shift 2;;
        --outdir) outdir="$2"; shift 2;;
        --fcversion) fcversion="$2"; shift 2;;

        --) shift; break;;
        -*) echo "unknown option: $1" >&2; exit 1;;
    esac
done

if [ -z "$spec" ] || [ -z "$outdir" ]; then
    echo "Error: --spec and --outdir must be provided." >&2
    exit 1
fi

mkdir -p $outdir

rpm_args=( --nodeps -bs "$spec" \
    --define "_sourcedir $(pwd)" \
    --define "_specdir $outdir" \
    --define "_builddir $outdir" \
    --define "_buildrootdir $outdir" \
    --define "_srcrpmdir $outdir" \
    --define "_rpmdir $outdir" )

if [ -n "$fcversion" ]; then
    rpm_args+=( --define "dist $fcversion" )
fi

rpmbuild "${rpm_args[@]}"
